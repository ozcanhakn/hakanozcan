# Copy to .env.local for local development, and set the same names in your hosting provider.
# Never put real values in this file: it is committed to Git.

# Supabase (public reads and the contact form)
NEXT_PUBLIC_SUPABASE_API_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Writing panel at /admin (server-side only, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# At least 32 random characters, for example: openssl rand -base64 48
ADMIN_SESSION_SECRET=
